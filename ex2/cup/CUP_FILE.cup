/*************/
/* IMPORT(S) */
/*************/
import java_cup.runtime.*;
import ast.*;

parser code 
{:
	public Lexer lexer;

	public Parser(Lexer lexer)
	{
		super(lexer);
		this.lexer = lexer;
	}

	public void report_error(String message, Object info)
	{
		int line = lexer.getLine();
		if (info instanceof Symbol)
		{
			Symbol s = (Symbol) info;
			if (s.left >= 0)
			{
				line = s.left + 1;
			}
		}
		throw new RuntimeException(String.valueOf(line));
	}

	public void syntax_error(Symbol cur_token)
	{
		report_error("Syntax error", cur_token);
	}
:}

/************************/
/* CUSTOMIZE CUP PARSER */
/************************/
scan with
{:
	Symbol s;
	s = lexer.next_token();
	System.out.print("[");
	System.out.print(lexer.getLine());
	System.out.print(":");
	System.out.print(lexer.getTokenStartPosition());
	System.out.print("] ");
	System.out.print(TokenNames.terminalNames[s.sym]);
	if (s.value != null)
	{
		System.out.print("( ");
		System.out.print(s.value);
		System.out.print(" )");
	}
	System.out.print("\n");
	return s; 
:};

/*************/
/* TERMINALS */
/*************/
/* Operators */
terminal PLUS;
terminal MINUS;
terminal TIMES;
terminal DIVIDE;
terminal EQ;
terminal LT;
terminal GT;
terminal AND;
terminal OR;
terminal ASSIGN;

/* Punctuation */
terminal LPAREN;
terminal RPAREN;
terminal LBRACK;
terminal RBRACK;
terminal LBRACE;
terminal RBRACE;
terminal COMMA;
terminal DOT;
terminal SEMICOLON;

/* Keywords */
terminal ARRAY;
terminal CLASS;
terminal EXTENDS;
terminal NEW;
terminal NIL;
terminal IF;
terminal ELSE;
terminal WHILE;
terminal RETURN;
terminal TYPE_INT;
terminal TYPE_STRING;
terminal TYPE_VOID;

/* Terminals with values */
terminal Integer INT;
terminal String ID;
terminal String STRING;

/*****************/
/* NON TERMINALS */
/*****************/
non terminal AstProgram program;
non terminal AstDecList decList;
non terminal AstDec dec;
non terminal AstType type;
non terminal AstDecVar varDec;
non terminal AstDecFunc funcDec;
non terminal AstParamList paramList;
non terminal AstDecClass classDec;
non terminal AstDecList cFieldList;
non terminal AstDec cField;
non terminal AstDecArray arrayTypedef;
non terminal AstStmtList stmtList;
non terminal AstStmt stmt;
non terminal AstExp exp;
non terminal AstExpNew newExp;
non terminal AstExpCall callExp;
non terminal AstExpList expList;
non terminal AstVar var;

/*******************************************************/
/* OPERATOR PRECEDENCE (Lowest = 1 to Highest = 10)    */
/*******************************************************/
precedence nonassoc ASSIGN;
precedence left OR;
precedence left AND;
precedence left EQ;
precedence left LT, GT;
precedence left PLUS, MINUS;
precedence left TIMES, DIVIDE;
precedence left LBRACK;
precedence nonassoc LPAREN;
precedence left DOT;

/**********************/
/* START WITH: program */
/**********************/
start with program;

/********************/
/* DERIVATION RULES */
/********************/

program         ::= decList:l
                    {:
                        RESULT = new AstProgram(l);
                        RESULT.lineNumber = lleft + 1;
                    :}
                    ;

decList         ::= dec:d decList:l
                    {:
                        RESULT = new AstDecList(d, l);
                        RESULT.lineNumber = dleft + 1;
                    :}
                    | dec:d
                    {:
                        RESULT = new AstDecList(d, null);
                        RESULT.lineNumber = dleft + 1;
                    :}
                    ;

dec             ::= varDec:v        {: RESULT = v; :}
                    | funcDec:f     {: RESULT = f; :}
                    | classDec:c    {: RESULT = c; :}
                    | arrayTypedef:a {: RESULT = a; :}
                    ;

type            ::= TYPE_INT:t
                    {:
                        RESULT = new AstType("int");
                        RESULT.lineNumber = tleft + 1;
                    :}
                    | TYPE_STRING:t
                    {:
                        RESULT = new AstType("string");
                        RESULT.lineNumber = tleft + 1;
                    :}
                    | TYPE_VOID:t
                    {:
                        RESULT = new AstType("void");
                        RESULT.lineNumber = tleft + 1;
                    :}
                    | ID:name
                    {:
                        RESULT = new AstType(name);
                        RESULT.lineNumber = nameleft + 1;
                    :}
                    ;

varDec          ::= type:t ID:name SEMICOLON
                    {:
                        RESULT = new AstDecVar(t, name, null);
                        RESULT.lineNumber = tleft + 1;
                    :}
                    | type:t ID:name ASSIGN exp:e SEMICOLON
                    {:
                        RESULT = new AstDecVar(t, name, e);
                        RESULT.lineNumber = tleft + 1;
                    :}
                    | type:t ID:name ASSIGN newExp:e SEMICOLON
                    {:
                        RESULT = new AstDecVar(t, name, e);
                        RESULT.lineNumber = tleft + 1;
                    :}
                    ;

funcDec         ::= type:t ID:name LPAREN RPAREN LBRACE stmtList:body RBRACE
                    {:
                        RESULT = new AstDecFunc(t, name, null, body);
                        RESULT.lineNumber = tleft + 1;
                    :}
                    | type:t ID:name LPAREN paramList:params RPAREN LBRACE stmtList:body RBRACE
                    {:
                        RESULT = new AstDecFunc(t, name, params, body);
                        RESULT.lineNumber = tleft + 1;
                    :}
                    ;

paramList       ::= type:t ID:name COMMA paramList:l
                    {:
                        RESULT = new AstParamList(t, name, l);
                        RESULT.lineNumber = tleft + 1;
                    :}
                    | type:t ID:name
                    {:
                        RESULT = new AstParamList(t, name, null);
                        RESULT.lineNumber = tleft + 1;
                    :}
                    ;

classDec        ::= CLASS:c ID:name LBRACE cFieldList:fields RBRACE
                    {:
                        RESULT = new AstDecClass(name, null, fields);
                        RESULT.lineNumber = cleft + 1;
                    :}
                    | CLASS:c ID:name EXTENDS ID:parent LBRACE cFieldList:fields RBRACE
                    {:
                        RESULT = new AstDecClass(name, parent, fields);
                        RESULT.lineNumber = cleft + 1;
                    :}
                    ;

cFieldList      ::= cField:f cFieldList:l
                    {:
                        RESULT = new AstDecList(f, l);
                        RESULT.lineNumber = fleft + 1;
                    :}
                    | cField:f
                    {:
                        RESULT = new AstDecList(f, null);
                        RESULT.lineNumber = fleft + 1;
                    :}
                    ;

cField          ::= varDec:v        {: RESULT = v; :}
                    | funcDec:f     {: RESULT = f; :}
                    ;

arrayTypedef    ::= ARRAY:a ID:name EQ type:t LBRACK RBRACK SEMICOLON
                    {:
                        RESULT = new AstDecArray(name, t);
                        RESULT.lineNumber = aleft + 1;
                    :}
                    ;

stmtList        ::= stmt:s stmtList:l
                    {:
                        RESULT = new AstStmtList(s, l);
                        RESULT.lineNumber = sleft + 1;
                    :}
                    | stmt:s
                    {:
                        RESULT = new AstStmtList(s, null);
                        RESULT.lineNumber = sleft + 1;
                    :}
                    ;

stmt            ::= varDec:v
                    {:
                        RESULT = new AstStmtVarDec(v);
                        RESULT.lineNumber = vleft + 1;
                    :}
                    | var:v ASSIGN exp:e SEMICOLON
                    {:
                        RESULT = new AstStmtAssign(v, e);
                        RESULT.lineNumber = vleft + 1;
                    :}
                    | var:v ASSIGN newExp:e SEMICOLON
                    {:
                        RESULT = new AstStmtAssign(v, e);
                        RESULT.lineNumber = vleft + 1;
                    :}
                    | RETURN:r SEMICOLON
                    {:
                        RESULT = new AstStmtReturn(null);
                        RESULT.lineNumber = rleft + 1;
                    :}
                    | RETURN:r exp:e SEMICOLON
                    {:
                        RESULT = new AstStmtReturn(e);
                        RESULT.lineNumber = rleft + 1;
                    :}
                    | IF:i LPAREN exp:cond RPAREN LBRACE stmtList:body RBRACE
                    {:
                        RESULT = new AstStmtIf(cond, body, null);
                        RESULT.lineNumber = ileft + 1;
                    :}
                    | IF:i LPAREN exp:cond RPAREN LBRACE stmtList:body RBRACE ELSE LBRACE stmtList:elseBody RBRACE
                    {:
                        RESULT = new AstStmtIf(cond, body, elseBody);
                        RESULT.lineNumber = ileft + 1;
                    :}
                    | WHILE:w LPAREN exp:cond RPAREN LBRACE stmtList:body RBRACE
                    {:
                        RESULT = new AstStmtWhile(cond, body);
                        RESULT.lineNumber = wleft + 1;
                    :}
                    | callExp:c SEMICOLON
                    {:
                        RESULT = new AstStmtCall(c);
                        RESULT.lineNumber = cleft + 1;
                    :}
                    ;

exp             ::= var:v
                    {:
                        RESULT = new AstExpVar(v);
                        RESULT.lineNumber = vleft + 1;
                    :}
                    | LPAREN exp:e RPAREN
                    {:
                        RESULT = e;
                    :}
                    | exp:e1 PLUS exp:e2
                    {:
                        RESULT = new AstExpBinop(e1, e2, 0);
                        RESULT.lineNumber = e1left + 1;
                    :}
                    | exp:e1 MINUS exp:e2
                    {:
                        RESULT = new AstExpBinop(e1, e2, 1);
                        RESULT.lineNumber = e1left + 1;
                    :}
                    | exp:e1 TIMES exp:e2
                    {:
                        RESULT = new AstExpBinop(e1, e2, 2);
                        RESULT.lineNumber = e1left + 1;
                    :}
                    | exp:e1 DIVIDE exp:e2
                    {:
                        RESULT = new AstExpBinop(e1, e2, 3);
                        RESULT.lineNumber = e1left + 1;
                    :}
                    | exp:e1 LT exp:e2
                    {:
                        RESULT = new AstExpBinop(e1, e2, 4);
                        RESULT.lineNumber = e1left + 1;
                    :}
                    | exp:e1 GT exp:e2
                    {:
                        RESULT = new AstExpBinop(e1, e2, 5);
                        RESULT.lineNumber = e1left + 1;
                    :}
                    | exp:e1 EQ exp:e2
                    {:
                        RESULT = new AstExpBinop(e1, e2, 6);
                        RESULT.lineNumber = e1left + 1;
                    :}
                    | exp:e1 AND exp:e2
                    {:
                        RESULT = new AstExpBinop(e1, e2, 7);
                        RESULT.lineNumber = e1left + 1;
                    :}
                    | exp:e1 OR exp:e2
                    {:
                        RESULT = new AstExpBinop(e1, e2, 8);
                        RESULT.lineNumber = e1left + 1;
                    :}
                    | callExp:c
                    {:
                        RESULT = c;
                    :}
                    | INT:i
                    {:
                        RESULT = new AstExpInt(i);
                        RESULT.lineNumber = ileft + 1;
                    :}
                    | MINUS:m INT:i
                    {:
                        RESULT = new AstExpInt(-i);
                        RESULT.lineNumber = mleft + 1;
                    :}
                    | NIL:n
                    {:
                        RESULT = new AstExpNil();
                        RESULT.lineNumber = nleft + 1;
                    :}
                    | STRING:s
                    {:
                        RESULT = new AstExpString(s);
                        RESULT.lineNumber = sleft + 1;
                    :}
                    ;

newExp          ::= NEW:n type:t
                    {:
                        RESULT = new AstExpNew(t, null);
                        RESULT.lineNumber = nleft + 1;
                    :}
                    | NEW:n type:t LBRACK exp:e RBRACK
                    {:
                        RESULT = new AstExpNew(t, e);
                        RESULT.lineNumber = nleft + 1;
                    :}
                    ;

callExp         ::= ID:name LPAREN RPAREN
                    {:
                        RESULT = new AstExpCall(null, name, null);
                        RESULT.lineNumber = nameleft + 1;
                    :}
                    | ID:name LPAREN expList:args RPAREN
                    {:
                        RESULT = new AstExpCall(null, name, args);
                        RESULT.lineNumber = nameleft + 1;
                    :}
                    | var:v DOT ID:name LPAREN RPAREN
                    {:
                        RESULT = new AstExpCall(v, name, null);
                        RESULT.lineNumber = vleft + 1;
                    :}
                    | var:v DOT ID:name LPAREN expList:args RPAREN
                    {:
                        RESULT = new AstExpCall(v, name, args);
                        RESULT.lineNumber = vleft + 1;
                    :}
                    ;

expList         ::= exp:e COMMA expList:l
                    {:
                        RESULT = new AstExpList(e, l);
                        RESULT.lineNumber = eleft + 1;
                    :}
                    | exp:e
                    {:
                        RESULT = new AstExpList(e, null);
                        RESULT.lineNumber = eleft + 1;
                    :}
                    ;

var             ::= ID:name
                    {:
                        RESULT = new AstVarSimple(name);
                        RESULT.lineNumber = nameleft + 1;
                    :}
                    | var:v DOT ID:fieldName
                    {:
                        RESULT = new AstVarField(v, fieldName);
                        RESULT.lineNumber = vleft + 1;
                    :}
                    | var:v LBRACK exp:e RBRACK
                    {:
                        RESULT = new AstVarSubscript(v, e);
                        RESULT.lineNumber = vleft + 1;
                    :}
                    ;